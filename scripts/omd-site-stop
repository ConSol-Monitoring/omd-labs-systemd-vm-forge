#!/usr/bin/env bash
# omd-site-stop - stop the single active OMD site (research.md D8, T018).
#
# Guarded wrapper (the unit file units/omd-site.service is UNCHANGED from
# T006): reads /run/omd-labs.env (D9 primary channel); SITE_ACTIVE=0 or an
# empty SITE_NAME => exit 0 no-op (NEVER expands to an empty `omd stop`
# name). Otherwise `/usr/bin/omd stop ${SITE_NAME}`, and the wrapper ALWAYS
# exits 0: `omd stop` exits 1 on an already-stopped site [EMPIRICAL] and
# the callers (the omd-site ExecStop, omd-ready's fatal cleanup, the halt
# sequence) must never be blocked by a site-stop non-zero.
set -euo pipefail

SITE_ACTIVE=0 SITE_NAME=""
if [ -r /run/omd-labs.env ]; then
    set -a; . /run/omd-labs.env; set +a
fi

if [ "$SITE_ACTIVE" != "1" ] || [ -z "$SITE_NAME" ]; then
    # no-site path (N1): nothing to stop - a silent, fast no-op
    exit 0
fi

/usr/bin/omd stop "${SITE_NAME}" >/dev/null 2>&1 || true
# tolerant by construction (D8): never a non-zero exit
exit 0
