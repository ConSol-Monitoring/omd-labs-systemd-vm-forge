# This file is used to manage local images
# depending of the current dir and branch.
# Branch 'master' leads to no tag (=latest),
# others to "local/[dirname]:[branchname]"
# the build hook (hooks/build) derives the Dockerfile name from DOCKER_REPO:
# Dockerfile.omd-labs-systemd-vm-<distro>
#
# FLAVOR selects the image target (Stage 2, base image):
#   omd   (default) - the OMD-preinstalled image (Dockerfile's final/`omd`
#                     stage) - the existing behavior, no new flags for
#                     existing users.
#   base  - the OMD-less chassis image (Dockerfile's `base` stage):
#           local/omd-labs-systemd-vm-base-<distro>:<TAG>, no OMD package,
#           both labs.consol.de repos configured, no site (SITENAME must be
#           empty; the entry fails fast if a site is requested without OMD).
#
# The OMD image is `FROM base AS omd` inside the same Dockerfile, so an OMD
# build always derives from the same-checkout base stage (built in the same
# invocation, cache-reused); no external base reference is involved.

ifeq ($(strip $(DISTRO)),)
    $(error DISTRO must not be empty, use Makefile.omd-labs-* instead)
endif

LOCAL_HTTPS_PORT ?= 8443

FLAVOR ?= omd
ifneq ($(FLAVOR),omd)
ifneq ($(FLAVOR),base)
    $(error FLAVOR must be omd (default) or base, got '$(FLAVOR)')
endif
endif

# local builds will be named like this
ifeq ($(FLAVOR),base)
    REPO = local/omd-labs-systemd-vm-base-$(DISTRO)
else
    REPO = local/omd-labs-systemd-vm-$(DISTRO)
endif
BRANCH=$(shell git rev-parse --abbrev-ref HEAD)
# BRANCH=TAG, but "master"="nightly"
TAG  = $(shell git rev-parse --abbrev-ref HEAD | sed 's/master/nightly/')
# the final image name
IMAGE=$(REPO):$(TAG)

# NOTE: no BASE_REF. The OMD image is `FROM base AS omd` INSIDE the same
# Dockerfile, so an OMD build always derives from the same-checkout base stage
# (built in the same invocation, cache-reused) - it never consumes a separate
# published/local base image. The FLAVOR flag is the only selector:
#   FLAVOR=base -> --target base (the chassis)
#   FLAVOR=omd  (default) -> the `omd` stage (the base stage is built first)

# v2: SITENAME is a RUNTIME variable — the container selects the site at
# start (empty/absent = no site, base services only). The `?=` demo default
# is a command-line convenience, NOT an image default (the image no longer
# bakes a site in — the build-time site block is retired).
# The base image has NO OMD: a site request fails fast, so the base flavor
# defaults to no site.
ifeq ($(FLAVOR),base)
    SITENAME ?=
else
    SITENAME ?= demo
endif

# the container runtime. The documented invocation is `--privileged`
# (+ `--systemd=always` on podman — its wrapper CMD does not match the
# auto-trigger's literal-command check).
RUNTIME ?= docker
ifeq ($(RUNTIME),podman)
  RTFLAGS = --systemd=always
else
  RTFLAGS =
endif

# SELinux-Enforcing hosts need the :z mount label on shared volume mounts
# (EMPIRICAL: a raw bind of a host dir is denied by the AVC policy).
# Overridable: make ... SELABEL=
SELABEL ?= $(shell getenforce 2>/dev/null | grep -qx Enforcing && printf ':z')

export DOCKER_REPO=index.docker.io/consol/omd-labs-$(DISTRO)
export IMAGE_NAME=$(IMAGE)
export SOURCE_BRANCH=$(BRANCH)
export FLAVOR

# the build stage selected from FLAVOR (hooks/build passes --target):
# omd -> the final/default stage; base -> the chassis stage
ifeq ($(FLAVOR),base)
  BUILD_TARGET=base
else
  BUILD_TARGET=omd
endif

.PHONY: build start startvol stop echo

build:
	# the hook is also executed on Docker Hub
	./hooks/build
	@echo "Successfully built" $(IMAGE)

# documented invocation (contracts/invocation.md "Make targets", v2):
# runtime SITENAME + the privileged flags; the build no longer passes
# SITENAME as a build argument (the build-time site is removed).
start:
	$(RUNTIME) run $(RTFLAGS) --privileged --name omd-labs-$(SITENAME) \
	-d -p $(LOCAL_HTTPS_PORT):443 -e SITENAME=$(SITENAME) $(IMAGE)

# start + a volume mounted at the site path (matches the runtime site name;
# the old demo-defaulted mount path is gone). VOLUME is required.
ifeq ($(strip $(VOLUME)),)
startvol:
	@echo "startvol requires VOLUME: make startvol VOLUME=/tmp/omd-make-vol SITENAME=make1" >&2; exit 1
else
startvol:
	$(RUNTIME) run $(RTFLAGS) --privileged --name omd-labs-$(SITENAME) \
	-d -p $(LOCAL_HTTPS_PORT):443 \
	-v $(VOLUME):/omd/sites/$(SITENAME)$(SELABEL) \
	-e SITENAME=$(SITENAME) $(IMAGE)
endif

# documented stop (research.md D2): the image's STOPSIGNAL SIGRTMIN+3 does
# the ordered halt; -t 30 = the documented timeout (works on docker and
# podman). Clean halt exits 130 (privileged) / 0 (rootless) — NOT a failure.
stop:
	$(RUNTIME) stop -t 30 omd-labs-$(SITENAME)

echo:
	@echo $(IMAGE)
